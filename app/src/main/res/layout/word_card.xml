<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/word_card_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/word_card_content"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?android:selectableItemBackground"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/word_card_headword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:fontFamily="sans-serif"
                android:textColor="@color/text_foreground_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="大きい・大きな  おおきい・おおきな" />

            <TableLayout
                android:id="@+id/word_card_senses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <EditText
                android:id="@+id/word_card_memo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@color/text_background_memo"
                app:fontFamily="sans-serif"
                android:padding="6dp"
                android:textColor="@color/text_foreground_primary"
                android:textSize="14sp"
                tools:text="Text 1"
                android:importantForAutofill="no"
                android:hint="Memo"
                android:inputType="textAutoCorrect|textMultiLine"
                android:visibility="gone" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/word_card_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:chipSpacingVertical="2dp"
                android:visibility="gone" />

            <AutoCompleteTextView
                android:id="@+id/word_card_tag_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/text_background_memo"
                app:fontFamily="sans-serif"
                android:padding="6dp"
                android:textColor="@color/text_foreground_primary"
                android:textSize="14sp"
                android:importantForAutofill="no"
                android:hint="@string/tag_input_hint"
                android:inputType="text|textNoSuggestions"
                android:imeOptions="actionDone"
                android:completionThreshold="1"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp">

            <ImageButton
                android:id="@+id/word_card_bookmark_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:paddingTop="5dp"
                android:paddingRight="5dp"
                android:paddingLeft="5dp"
                android:contentDescription="@string/bookmark_icon_description"
                android:tint="@color/text_foreground_primary"
                android:src="@drawable/ic_outline_bookmark_border_24px"/>

            <ImageButton
                android:id="@+id/word_card_memo_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:paddingTop="5dp"
                android:paddingRight="5dp"
                android:paddingLeft="5dp"
                android:contentDescription="@string/bookmark_icon_description"
                android:tint="@color/text_foreground_primary"
                android:src="@drawable/ic_edit_24px"/>

            <ImageButton
                android:id="@+id/word_card_delete_memo_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:paddingTop="5dp"
                android:paddingRight="5dp"
                android:paddingLeft="5dp"
                android:contentDescription="@string/bookmark_icon_description"
                android:tint="@color/text_foreground_primary"
                android:src="@drawable/ic_delete_24px"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/word_card_tag_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:paddingTop="5dp"
                android:paddingRight="5dp"
                android:paddingLeft="5dp"
                android:contentDescription="@string/tag_icon_description"
                android:tint="@color/text_foreground_primary"
                android:src="@drawable/ic_outline_class_24px"/>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
