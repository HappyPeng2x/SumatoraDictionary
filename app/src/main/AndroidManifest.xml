<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.happypeng.sumatora.android.sumatoradictionary">

    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />

            <data
                android:mimeType="application/json"
                android:scheme="content" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />

            <data
                android:mimeType="text/xml"
                android:scheme="content" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />

            <data
                android:mimeType="application/json"
                android:scheme="content" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />

            <data
                android:mimeType="text/xml"
                android:scheme="content" />
        </intent>
        <intent>
            <action android:name="android.intent.action.EDIT" />

            <data
                android:mimeType="application/json"
                android:scheme="content" />
        </intent>
        <intent>
            <action android:name="android.intent.action.EDIT" />

            <data
                android:mimeType="text/xml"
                android:scheme="content" />
        </intent>
    </queries>

    <!-- Needed only for downloading the optional search_suffix/names dictionary packs
         (Settings > Manage dictionaries). Everything else in the app works fully offline. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".DictionaryApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_sumatora_icon"
        android:label="@string/app_name"
        android:supportsRtl="true">
<!--        <service
            android:name=".service.DictionaryDownloadService"
            android:enabled="true"
            android:exported="true"></service>-->

        <activity android:name=".activity.DictionaryLaunchActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.DictionaryBookmarksImportActivity"
            android:exported="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />

                <category android:name="android.intent.category.DEFAULT" />

                <data
                    android:mimeType="text/xml"
                    android:scheme="content" />
                <data
                    android:mimeType="application/json"
                    android:scheme="content" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.DictionariesManagementActivity"
            android:label="@string/manage_dictionaries_title"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".activity.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />
        </activity>
        <activity
            android:name=".activity.AboutActivity"
            android:theme="@style/AppTheme.AboutActivity" />
        <activity
            android:name=".activity.LicenseActivity"
            android:label="License"
            android:theme="@style/AppTheme">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.AboutActivity" />
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="org.happypeng.sumatora.android.sumatoradictionary.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <!-- Manifest-registered (not runtime-only) so a download started from the Settings
             screen still gets installed even if the app process was killed while it ran. -->
        <receiver
            android:name=".receiver.DictionaryDownloadCompleteReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>